# Copy this file to .env (default) or .env.<name> (e.g. .env.qa) and fill in values.
# Real .env files are gitignored; this template is not.

# Base URL of the application under test (used as Playwright baseURL)
URL=

# Email domain used when generating fake test users with faker (e.g. example.com)
TEST_USER_EMAIL_DOMAIN=
